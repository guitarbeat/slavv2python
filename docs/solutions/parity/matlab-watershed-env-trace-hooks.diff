+function values = parse_trace_integer_list( raw_value )
+    values = [];
+    if isempty( raw_value ), return, end
+    tokens = regexp( raw_value, '[,;\s]+', 'split' );
+    for token_idx = 1 : numel( tokens )
+        token = strtrim( tokens{ token_idx } );
+        if isempty( token ), continue, end
+        value = str2double( token );
+        if ~ isnan( value ), values( end + 1 ) = round( value ); end %#ok<AGROW>
+    end
+end
+
+function value = parse_trace_scalar( raw_value, default_value )
+    value = default_value ;
+    if isempty( raw_value ), return, end
+    parsed = str2double( raw_value );
+    if ~ isnan( parsed ), value = max( 1, round( parsed )); end
+end
+
+function write_strel_trace_event( fid, iterations, targets, sample_limit, iteration, current_location, current_vertex_index, current_scale_label, current_pointer_value, current_d_over_r, ...
+                                  strel_linear, strel_pointer_indices, strel_r_over_R, raw_energies, adjusted_energies, vertices_before_claim, is_without_vertex, ...
+                                  pointer_before_claim, d_over_r_before_claim, size_before_claim, vertices_after_claim, pointer_after_claim, d_over_r_after_claim, size_after_claim )
+    if fid <= 0, return, end
+    if ~ isempty( iterations ) && ~ any( iterations == iteration ), return, end
+
+    [ ~, order ] = sortrows([ adjusted_energies(:), double( strel_linear(:)) ], [ 1, 2 ]);
+    sample_indices = order( 1 : min( sample_limit, numel( order )));
+
+    event = struct();
+    event.event = 'strel_state';
+    event.iteration = double( iteration );
+    event.current_linear = double( current_location );
+    event.current_vertex_index = double( current_vertex_index );
+    event.current_scale_label = double( current_scale_label );
+    event.current_pointer_value = double( current_pointer_value );
+    event.current_d_over_r = double( current_d_over_r );
+    event.top_adjusted = build_strel_trace_rows( sample_indices, strel_linear, strel_pointer_indices, strel_r_over_R, raw_energies, adjusted_energies, ...
+                                                 vertices_before_claim, is_without_vertex, pointer_before_claim, d_over_r_before_claim, size_before_claim, ...
+                                                 vertices_after_claim, pointer_after_claim, d_over_r_after_claim, size_after_claim );
+    target_indices = find( ismember( double( strel_linear(:) ), double( targets(:) )));
+    event.targets = build_strel_trace_rows( target_indices, strel_linear, strel_pointer_indices, strel_r_over_R, raw_energies, adjusted_energies, ...
+                                            vertices_before_claim, is_without_vertex, pointer_before_claim, d_over_r_before_claim, size_before_claim, ...
+                                            vertices_after_claim, pointer_after_claim, d_over_r_after_claim, size_after_claim );
+    fprintf( fid, '%s\n', jsonencode( event ));
+end
+
+function write_frontier_action_event( fid, targets, iteration, action, current_location, locations, seed_idx, energy_value, branch_order, next_vertex_index )
+    if fid <= 0, return, end
+    if isempty( targets ), return, end
+    target_locations = intersect( double( locations(:)' ), double( targets ));
+    if isempty( target_locations ), return, end
+
+    event = struct();
+    event.event = 'frontier_action';
+    event.iteration = double( iteration );
+    event.action = action;
+    event.current_linear = double( current_location );
+    event.target_locations = target_locations;
+    event.details = struct( ...
+        'seed_idx', double( seed_idx ), ...
+        'energy', double( energy_value ), ...
+        'branch_order', double( branch_order ), ...
+        'next_vertex_index', double( next_vertex_index ));
+    fprintf( fid, '%s\n', jsonencode( event ));
+end
+
+function rows = build_strel_trace_rows( indices, strel_linear, strel_pointer_indices, strel_r_over_R, raw_energies, adjusted_energies, vertices_before_claim, is_without_vertex, ...
+                                        pointer_before_claim, d_over_r_before_claim, size_before_claim, vertices_after_claim, pointer_after_claim, d_over_r_after_claim, size_after_claim )
+    rows = repmat( struct( ...
+        'strel_index', [], ...
+        'linear', [], ...
+        'strel_pointer', [], ...
+        'strel_r_over_R', [], ...
+        'raw_energy', [], ...
+        'adjusted_energy', [], ...
+        'vertex_index_before_claim', [], ...
+        'is_without_vertex', [], ...
+        'pointer_before_claim', [], ...
+        'd_over_r_before_claim', [], ...
+        'size_before_claim', [], ...
+        'vertex_index_after_claim', [], ...
+        'pointer_after_claim', [], ...
+        'd_over_r_after_claim', [], ...
+        'size_after_claim', [] ), numel( indices ), 1 );
+    for trace_row_idx = 1 : numel( indices )
+        trace_strel_idx = indices( trace_row_idx );
+        rows( trace_row_idx ).strel_index = double( trace_strel_idx );
+        rows( trace_row_idx ).linear = double( strel_linear( trace_strel_idx ));
+        rows( trace_row_idx ).strel_pointer = double( strel_pointer_indices( trace_strel_idx ));
+        rows( trace_row_idx ).strel_r_over_R = double( strel_r_over_R( trace_strel_idx ));
+        rows( trace_row_idx ).raw_energy = double( raw_energies( trace_strel_idx ));
+        rows( trace_row_idx ).adjusted_energy = double( adjusted_energies( trace_strel_idx ));
+        rows( trace_row_idx ).vertex_index_before_claim = double( vertices_before_claim( trace_strel_idx ));
+        rows( trace_row_idx ).is_without_vertex = logical( is_without_vertex( trace_strel_idx ));
+        rows( trace_row_idx ).pointer_before_claim = double( pointer_before_claim( trace_strel_idx ));
+        rows( trace_row_idx ).d_over_r_before_claim = double( d_over_r_before_claim( trace_strel_idx ));
+        rows( trace_row_idx ).size_before_claim = double( size_before_claim( trace_strel_idx ));
+        rows( trace_row_idx ).vertex_index_after_claim = double( vertices_after_claim( trace_strel_idx ));
+        rows( trace_row_idx ).pointer_after_claim = double( pointer_after_claim( trace_strel_idx ));
+        rows( trace_row_idx ).d_over_r_after_claim = double( d_over_r_after_claim( trace_strel_idx ));
+        rows( trace_row_idx ).size_after_claim = double( size_after_claim( trace_strel_idx ));
+    end
+end
+
+end % FUNCTION get_edges_by_watershed
 
 
